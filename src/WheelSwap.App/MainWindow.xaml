<Window x:Class="WheelSwap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WheelSwap.App"
        Title="Steering Wheel Swapper" Height="960" Width="900" MinHeight="780" MinWidth="700"
        Background="{StaticResource Paper}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- brand band -->
        <DockPanel Background="{StaticResource Purple}" Height="64" LastChildFill="False">
            <Image DockPanel.Dock="Left" Source="{StaticResource Wordmark}" Height="20" Margin="26,0,0,0" VerticalAlignment="Center"/>
            <local:Tracked DockPanel.Dock="Right" Text="Steering Wheel Swapper" Margin="0,0,26,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="12" Tracking="0.16" Foreground="{StaticResource Paper}"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="110"/>
            </Grid.RowDefinitions>

            <!-- the faded "26" from the RM Designs posts (drawn first, so everything sits on top of it) -->
            <TextBlock Grid.Row="0" Grid.RowSpan="3" Text="26" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="132"
                       Foreground="{StaticResource Purple}" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-26,-4,0" IsHitTestVisible="False"/>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <local:Tracked Text="Wheel Swap" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="22" Tracking="0.1" VerticalAlignment="Center"/>
                    <!-- version: purple box, white Roboto Mono Bold (as in the RM Designs posts) -->
                    <Border Background="{StaticResource Purple}" Padding="10,4,10,5" Margin="16,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Version">
                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Paper}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                           Text="*any 2025 or 2026 wheel, paddles &amp; hand animation into a serps template · your template is never changed"
                           ToolTip="Tip: drop a .serps file onto this window to open it."/>
            </StackPanel>
            <Border Grid.Row="1" Height="1" Background="{StaticResource Purple}" Margin="0,16,0,16"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <local:Tracked Style="{StaticResource Label}" Text="F1 25 game folder"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Detect" Click="Detect_Click"/>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseGame_Click"/>
                    <TextBox x:Name="GameBox"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <local:Tracked Style="{StaticResource Label}" Text="SERPs template"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseTemplate_Click"/>
                    <TextBox x:Name="TemplateBox" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,14">
                <local:Tracked Style="{StaticResource Label}" Text="Cars to give the new wheel"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,2" MinHeight="44">
                    <Grid>
                        <ItemsControl x:Name="EntryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,9" ToolTip="{Binding Tooltip}">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                                  AutomationProperties.Name="{Binding Label}">
                                            <DockPanel LastChildFill="True">
                                                <local:Tracked DockPanel.Dock="Left" Text="{Binding Title}" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Tracking="0.1"/>
                                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Brush}" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <local:Tracked Text="{Binding Text}" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="8.5"
                                                                               Tracking="0.14" Foreground="{StaticResource Ink}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            </DockPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EntryHint" Style="{StaticResource Sub}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,12"
                                   Text="pick a template to list its cars."/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,8">
                <local:Tracked Style="{StaticResource Label}" Text="Steering wheel from"/>
                <ListBox x:Name="DonorBox" Style="{StaticResource Chips}" SelectionChanged="Donor_Changed">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Sub}" FontSize="11" Margin="0,0,0,5"
                                               Text="{Binding Name, StringFormat='{}{0} cars'}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,16">
                <local:Tracked Style="{StaticResource Label}" Text="Save as"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOut_Click"/>
                    <TextBox x:Name="OutBox"/>
                </DockPanel>
            </StackPanel>

            <DockPanel Grid.Row="7" Margin="0,0,0,14" LastChildFill="False">
                <Button x:Name="BuildButton" DockPanel.Dock="Left" Style="{StaticResource Primary}" Margin="0" Content="Build" Click="Build_Click"/>
                <Button x:Name="PreviewButton" DockPanel.Dock="Left" Margin="10,0,0,0" Height="38" Content="Preview" Click="Preview_Click"
                        AutomationProperties.Name="Preview"
                        ToolTip="Trial build (checked, nothing saved) shown in 3D in your browser: the new wheel with its textures, before/after"/>
                <CheckBox x:Name="ReportBox" DockPanel.Dock="Left" Margin="18,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Save a report"
                          ToolTip="Also save an HTML page next to the new .serps with before/after pictures of the wheel, its textures and the checks">
                    <local:Tracked Text="Save a report" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="10.5" Tracking="0.14"/>
                </CheckBox>
                <Button x:Name="ReportButton" DockPanel.Dock="Left" Margin="14,0,0,0" Content="Open report" Visibility="Collapsed"
                        AutomationProperties.Name="Open report"
                        ToolTip="Before/after pictures of the wheel, textures and verification for this build" Click="Report_Click"/>
                <Border x:Name="StatusPill" DockPanel.Dock="Right" Padding="10,6" VerticalAlignment="Center" Visibility="Collapsed" Background="{StaticResource Teal}">
                    <local:Tracked x:Name="StatusText" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="9.5" Tracking="0.14" Foreground="{StaticResource Ink}"/>
                </Border>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="140" Height="4" Margin="0,0,14,0" IsIndeterminate="True" Visibility="Collapsed"
                             Background="{StaticResource LineSoft}" BorderThickness="0" Foreground="{StaticResource Purple}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="8" Background="{StaticResource Deep}">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8,8,2,8">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" LineHeight="18"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        </Grid>
    </Grid>
</Window>
